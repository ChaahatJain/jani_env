universe = docker
docker_image = chaahatjain/jani_in_python:latest
executable = /home/jain/jani_env/experiments/test_submission/run.sh
getenv = HOME
+WantGPUHomeMounted = true
should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT

requirements = UidDomain == "coli.uni-saarland.de"

request_GPUs = 0
request_CPUs = 1
request_memory = 8G

output = logs/test.$(ClusterId).$(ProcId).out
error  = logs/test.$(ClusterId).$(ProcId).err
log    = logs/test.$(ClusterId).$(ProcId).log

queue 1

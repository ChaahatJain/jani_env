universe = docker
docker_image = chaahatjain/jani_in_python:latest

executable = /usr/bin/env
transfer_executable = False

getenv = HOME
+WantGPUHomeMounted = true

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True

requirements = UidDomain == "cs.uni-saarland.de"

request_GPUs = 0
request_CPUs = 1
request_memory = 16G

periodic_remove = (time() - JobStartDate) > 21600

output = logs/$(ClusterId).$(ProcId)_fault_shard$(Process).out
error  = logs/$(ClusterId).$(ProcId)_fault_shard$(Process).err
log    = logs/$(ClusterId).$(ProcId)_fault_shard$(Process).log

# There are 100,000 initial states. The 20 jobs below process disjoint shards
# of approximately 5,000 starts each. The fixed seed-0 policy is never modified.
arguments = bash \
  /home/atml_team041/condor_tutorial/jani_env/experiments/repair_wo_domain/execute_fault_collection.sh collect \
  --jani-model /home/atml_team041/condor_tutorial/jani_env/benchmarks_generator/benchmarks/transport_/linetrack_20_10/model.jani \
  --jani-property /home/atml_team041/condor_tutorial/jani_env/benchmarks_generator/benchmarks/transport_/linetrack_20_10/model.jani \
  --start-states /home/atml_team041/condor_tutorial/jani_env/benchmarks_generator/benchmarks/transport_/linetrack_20_10/pa_model_random_starts_100000.jani \
  --policy /home/atml_team041/condor_tutorial/jani_env/artifacts/learning/transport_linetrack_20_10/mask_ppo_best_params_seed0/models/final_actor.pth \
  --output-dir /home/atml_team041/condor_tutorial/jani_env/artifacts/fault_collection/transport_linetrack_20_10/mask_ppo_best_params_seed0/shard_$(Process) \
  --max-steps 2000 \
  --max-state-visits 3 \
  --num-shards 20 \
  --shard-id $(Process) \
  --action-scope policy \
  --include-decoded-state \
  --device cpu \
  --seed 0

queue 20

universe = docker
docker_image = chaahatjain/jani_in_python:latest
executable = /home/atml_team041/condor_tutorial/jani_env/experiments/repair_wo_domain/execute_policy_comparison.sh
getenv = HOME
+WantGPUHomeMounted = true
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

requirements = UidDomain == "cs.uni-saarland.de"

request_GPUs = 0
request_CPUs = 4
request_memory = 16G
periodic_remove = (time() - JobStartDate) > 21600

output = logs/$(ClusterId).$(ProcId)_compare_seed$(SEED).out
error = logs/$(ClusterId).$(ProcId)_compare_seed$(SEED).err
log = logs/$(ClusterId).$(ProcId)_compare_seed$(SEED).log

arguments = \
  --jani_model /home/atml_team041/condor_tutorial/jani_env/benchmarks_generator/benchmarks/transport_/linetrack_17_10/model.jani \
  --jani_property /home/atml_team041/condor_tutorial/jani_env/benchmarks_generator/benchmarks/transport_/linetrack_17_10/model.jani \
  --start_states /home/atml_team041/condor_tutorial/jani_env/benchmarks_generator/benchmarks/transport_/linetrack_17_10/pa_model_random_starts_100000.jani \
  --before_policy /home/atml_team041/condor_tutorial/jani_env/artifacts/learning/transport_linetrack_17_10/mask_ppo_best_params_seed$(SEED)/models/final_actor.pth \
  --after_policy /home/atml_team041/condor_tutorial/jani_env/artifacts/repair/transport_linetrack_17_10/mask_ppo_best_params_seed$(SEED)/milp/repair_checkpoints/milp/final_policy.pth \
  --output_dir /home/atml_team041/condor_tutorial/jani_env/artifacts/policy_comparison/transport_linetrack_17_10/seed$(SEED)/milp_vs_original \
  --max_steps 2000 \
  --max_state_visits 100 \
  --search_states 1000 \
  --fault_scan_states 200 \
  --seed $(SEED)

queue SEED from (
0
)

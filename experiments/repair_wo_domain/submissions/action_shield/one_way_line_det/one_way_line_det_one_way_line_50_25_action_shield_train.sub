universe = docker
docker_image = chaahatjain/jani_in_python:latest

executable = /usr/bin/env
transfer_executable = False

getenv = HOME
+WantGPUHomeMounted = true

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True

requirements = UidDomain == "cs.uni-saarland.de"

request_GPUs = 0
request_CPUs = 4
request_memory = 16G

periodic_remove = (time() - JobStartDate) > 43200

output = logs/$(ClusterId).$(ProcId)_shield_train.out
error  = logs/$(ClusterId).$(ProcId)_shield_train.err
log    = logs/$(ClusterId).$(ProcId)_shield_train.log

arguments = bash \
  /home/atml_team041/condor_tutorial/jani_env/experiments/repair_wo_domain/execute_action_shield.sh train \
  --collection-dir /home/atml_team041/condor_tutorial/jani_env/artifacts/action_shield_multitask/one_way_line_det_one_way_line_50_25/mask_ppo_best_params_seed0/collection/merged \
  --output-dir /home/atml_team041/condor_tutorial/jani_env/artifacts/action_shield_multitask/one_way_line_det_one_way_line_50_25/mask_ppo_best_params_seed0/classifiers \
  --hidden-dims 128 64 \
  --dropout 0.1 \
  --epochs 150 \
  --patience 20 \
  --batch-size 1024 \
  --learning-rate 0.001 \
  --weight-decay 0.00001 \
  --target-validation-recall 0.99 \
  --max-negative-examples-per-action 250000 \
  --minimum-positive-examples 10 \
  --device cpu \
  --seed 0

queue 1

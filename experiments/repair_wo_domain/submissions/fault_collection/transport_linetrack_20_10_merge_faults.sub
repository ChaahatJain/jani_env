universe = docker
docker_image = chaahatjain/jani_in_python:latest

executable = /usr/bin/env
transfer_executable = False

getenv = HOME
+WantGPUHomeMounted = true

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True

requirements = UidDomain == "cs.uni-saarland.de"

request_GPUs = 0
request_CPUs = 1
request_memory = 16G

output = logs/$(ClusterId).$(ProcId)_fault_merge.out
error  = logs/$(ClusterId).$(ProcId)_fault_merge.err
log    = logs/$(ClusterId).$(ProcId)_fault_merge.log

arguments = bash \
  /home/atml_team041/condor_tutorial/jani_env/experiments/repair_wo_domain/execute_fault_collection.sh merge \
  --input-dir /home/atml_team041/condor_tutorial/jani_env/artifacts/fault_collection/transport_linetrack_20_10/mask_ppo_best_params_seed0 \
  --output-dir /home/atml_team041/condor_tutorial/jani_env/artifacts/fault_collection/transport_linetrack_20_10/mask_ppo_best_params_seed0/merged \
  --expected-shards 20

queue 1

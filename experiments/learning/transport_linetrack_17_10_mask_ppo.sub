universe = docker
docker_image = chaahatjain/jani_in_python:latest
executable = /home/atml_team041/condor_tutorial/jani_env/experiments/learning/execute_learning.sh
getenv = HOME
+WantGPUHomeMounted = true
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

requirements = UidDomain == "cs.uni-saarland.de"

request_GPUs = 0
request_CPUs = 4
request_memory = 16G
periodic_remove = (time() - JobStartDate) > 21600

output = logs/$(ClusterId).$(ProcId).out
error = logs/$(ClusterId).$(ProcId).err
log = logs/$(ClusterId).$(ProcId).log

arguments = \
  --algo mask_ppo \
  --jani_model /home/atml_team041/condor_tutorial/jani_env/benchmarks_generator/benchmarks/transport_/linetrack_17_10/model.jani \
  --jani_property /home/atml_team041/condor_tutorial/jani_env/benchmarks_generator/benchmarks/transport_/linetrack_17_10/model.jani \
  --start_states /home/atml_team041/condor_tutorial/jani_env/benchmarks_generator/benchmarks/transport_/linetrack_17_10/pa_model_random_starts_100000.jani \
  --max_steps 2000 \
  --total_timesteps 5000000 \
  --n_steps 2048 \
  --n_envs 4 \
  --failure_reward -10.0 \
  --step_reward -0.001 \
  --cycle_reward -0.1 \
  --use_oracle \
  --unsafe_reward -0.5 \
  --ent_coef 0.005 \
  --n_eval_episodes 200 \
  --max_state_visits 5 \
  --eval_freq 50000 \
  --save_all_checkpoints \
  --model_save_dir /home/atml_team041/condor_tutorial/jani_env/artifacts/learning/transport_linetrack_17_10/mask_ppo/models \
  --perf_file /home/atml_team041/condor_tutorial/jani_env/artifacts/learning/transport_linetrack_17_10/mask_ppo/perf.csv \
  --log_dir /home/atml_team041/condor_tutorial/jani_env/artifacts/learning/transport_linetrack_17_10/mask_ppo/logs \
  --unique_states_log /home/atml_team041/condor_tutorial/jani_env/artifacts/learning/transport_linetrack_17_10/mask_ppo/unique_states.csv \
  --unique_states_log_freq 10000 \
  --device cpu \
  --seed 42 \
  --disable_wandb

queue

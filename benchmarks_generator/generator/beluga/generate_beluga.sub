universe = docker
docker_image = chaahatjain/jani_in_python:latest
environment = "PYTHONPATH=/home/atml_team041/condor_tutorial/jani_env/benchmarks_generator/benchmarks_library:/home/atml_team041/condor_tutorial/jani_env/benchmarks_generator/python_library"
executable = /home/atml_team041/condor_tutorial/jani_env/benchmarks_generator/generator/beluga/generate_model.sh

getenv = HOME
+WantGPUHomeMounted = true
should_transfer_files = NO

requirements = UidDomain == "cs.uni-saarland.de"

request_GPUs = 0
